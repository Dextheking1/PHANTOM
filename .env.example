# PHANTOM Configuration
PORT=1337
HOST=127.0.0.1
API_BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-api-key-here
API_MODEL=gpt-4o
TEMPERATURE=0.7
MAX_TOKENS=4096
MAX_TOOL_ITERATIONS=12
MAX_WS_MESSAGE_BYTES=262144

# Set this when binding beyond localhost or running in production.
# API_TOKEN=replace-with-a-long-random-token

# Test Credentials
TEST_API_KEY=your-test-api-key-here
TEST_API_BASE_URL=https://integrate.api.nvidia.com/v1
TEST_API_MODEL=nvidia/nemotron-3-super-120b-a12b

# Telegram Integration (optional)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (e.g. 8418185701)
# Get it from @userinfobot on Telegram
TELEGRAM_USER_ID=
